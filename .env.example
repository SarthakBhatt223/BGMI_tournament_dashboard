# Copy to .env and edit. .env is ignored by git. Never commit real secrets.

# Port the backend listens on.
PORT=3001

# 127.0.0.1 = this computer only (Configuration A).
# 0.0.0.0   = reachable from the local network (Configuration B). Requires ADMIN_SECRET.
HOST=127.0.0.1

# Required when HOST is not a loopback address. Sent by the admin panel as the
# "x-admin-secret" header on every score-changing request.
ADMIN_SECRET=

# SQLite file. Relative paths are resolved from the project root.
DATABASE_PATH=data/tournament.db

# Folder holding ambient.mp4 and uploaded team logos.
MEDIA_DIR=public/media

# Load clearly fictional placeholder teams on an empty database (true/false).
SEED_DEMO_DATA=true
