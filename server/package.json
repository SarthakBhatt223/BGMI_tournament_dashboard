{
  "name": "bgmi-tournament-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=../.env src/index.js",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=../.env src/index.js",
    "db:migrate": "node --disable-warning=ExperimentalWarning --env-file-if-exists=../.env src/db/migrate.js",
    "db:seed": "node --disable-warning=ExperimentalWarning --env-file-if-exists=../.env src/db/seed.js",
    "db:reset": "node --disable-warning=ExperimentalWarning --env-file-if-exists=../.env src/db/reset.js",
    "test": "node --test --disable-warning=ExperimentalWarning \"src/tests/*.test.js\""
  },
  "dependencies": {
    "eslint": "9.39.5",
    "express": "^4.22.3",
    "react-router-dom": "^7.18.5",
    "socket.io": "4.8.1",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "socket.io-client": "4.8.1"
  }
}
